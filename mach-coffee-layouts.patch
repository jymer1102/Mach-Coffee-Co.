+
+  .error-actions {
+    display: flex;
+    justify-content: center;
+    gap: 16px;
+    flex-wrap: wrap;
+  }
+
+  /* Radar scanning element */
+  .radar-wrap {
+    width: 120px;
+    height: 120px;
+    margin: 0 auto 30px;
+    position: relative;
+    border-radius: 50%;
+    border: 2px solid var(--navy);
+    background: radial-gradient(circle, rgba(27,42,74,0.05) 0%, rgba(27,42,74,0.15) 100%);
+    box-shadow: 0 0 15px rgba(27,42,74,0.1);
+  }
+
+  .radar-wrap::before, .radar-wrap::after {
+    content: '';
+    position: absolute;
+    background: rgba(27,42,74,0.2);
+  }
+
+  .radar-wrap::before {
+    top: 50%; left: 0; right: 0; height: 1px;
+  }
+
+  .radar-wrap::after {
+    left: 50%; top: 0; bottom: 0; width: 1px;
+  }
+
+  .radar-sweep {
+    position: absolute;
+    top: 0; left: 0; right: 0; bottom: 0;
+    border-radius: 50%;
+    background: conic-gradient(from 0deg, transparent 0deg, transparent 270deg, rgba(201,162,75,0.4) 360deg);
+    animation: radar-spin 4s linear infinite;
+  }
+
+  @keyframes radar-spin {
+    from { transform: rotate(0deg); }
+    to { transform: rotate(360deg); }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    .radar-sweep { animation: none; }
+  }
